# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# Optional but strongly recommended: Hive API key.
# Without it, the rate limit is very low. Request one at: api@hivemc.com
HIVE_API_KEY=

# How often (in seconds) tracked players are checked for stat changes.
# Requests are internally staggered across this interval to protect the
# rate limit. Without HIVE_API_KEY, don't go below 30-45s with multiple
# tracked players.
POLL_INTERVAL_SECONDS=45

# Optional fallback channel ID if /track somehow runs without channel context
ALERT_CHANNEL_ID=

# Where the tracked-player watchlist is stored
# On Railway: mount a Volume here, otherwise the list is lost on every redeploy!
DATA_FILE=data/tracked.json
