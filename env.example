# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=dein-discord-bot-token

# Optional, aber dringend empfohlen: Hive-API-Key.
# Ohne Key ist das Rate-Limit sehr niedrig (seit Juli 2025 verschaerft).
# Beantragen unter: api@hivemc.com
HIVE_API_KEY=

# Wie oft (in Sekunden) beobachtete Spieler auf Stats-Aenderungen geprueft werden.
# Requests werden intern ueber dieses Intervall gestaffelt, um Rate-Limits zu schonen.
# Ohne HIVE_API_KEY nicht zu niedrig waehlen (z.B. nicht unter 30-45s bei mehreren Spielern).
POLL_INTERVAL_SECONDS=45

# Optionale Fallback-Channel-ID, falls kein Channel beim /track mitgegeben wurde
ALERT_CHANNEL_ID=

# Wo die Liste der beobachteten Spieler gespeichert wird
# Auf Railway: mit einem Volume mounten, sonst geht die Liste bei jedem Deploy verloren!
DATA_FILE=data/tracked.json

POLL_INTERVAL_SECONDS=45
